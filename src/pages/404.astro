---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/ui/Button.astro';
import IvyVine from '../components/art/IvyVine.astro';
---

<BaseLayout
  title="Página no encontrada | Yedra Café"
  description="Esta página no existe. Vuelve al inicio de Yedra Café, cafetería en Benicalap."
  path="/404"
  noindex
>
  <section class="nf">
    <div class="nf__vine">
    <IvyVine
      animate="load"
      viewBox="0 0 400 600"
      start={[200, 620]}
      segments={[
        [[120, 520], [280, 420], [190, 320]],
        [[110, 230], [250, 140], [210, 30]],
      ]}
      leafCount={12}
      leafSize={70}
      seed={404}
    />
    </div>
    <div class="wrap nf__inner">
      <h1>Esta página no existe.</h1>
      <p>Puede que el enlace esté mal escrito o que la página se haya movido.</p>
      <Button href="/">Volver al inicio</Button>
    </div>
  </section>
</BaseLayout>

<style>
  .nf {
    position: relative;
    display: grid;
    align-items: center;
    min-height: 100svh;
    background: var(--toldo);
    color: var(--cal);
    overflow: clip;
  }

  .nf__inner {
    position: relative;
    display: grid;
    gap: var(--space-5);
    justify-items: start;
    padding-top: var(--header-h);
  }

  h1 {
    font-size: var(--step-5);
    max-width: 12ch;
  }

  .nf__vine {
    position: absolute;
    right: 0;
    bottom: 0;
    height: 90%;
    width: auto;
    aspect-ratio: 2 / 3;
    opacity: 0.9;
  }
</style>
