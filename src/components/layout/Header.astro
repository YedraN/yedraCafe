---
import { business, maps, fullAddress } from '../../data/business';
import { nav } from '../../data/site';
import Icon from '../ui/Icon.astro';
import Wordmark from '../ui/Wordmark.astro';

interface Props {
  start?: 'dark' | 'light';
}

const { start = 'dark' } = Astro.props;
const instagram = business.social.find((s) => s.id === 'instagram');
---

<header class="header" data-header data-start={start}>
  <div class="header__bar wrap">
    <a class="header__brand" href="/">
      <Wordmark />
      <span class="visually-hidden">, inicio</span>
    </a>

    <nav class="header__nav" aria-label="Principal">
      <ul role="list">
        {
          nav.map((item) => (
            <li>
              <a class="header__link" href={item.href}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <a class="header__cta" href={maps.directions} target="_blank" rel="noopener noreferrer">
      <Icon name="directions" size={16} />
      <span>Cómo llegar</span>
      <span class="visually-hidden"> (Google Maps, pestaña nueva)</span>
    </a>

    <button class="header__toggle" type="button" aria-expanded="false" aria-controls="menu-movil" data-menu-toggle>
      <span class="header__toggle-label" data-menu-label>Menú</span>
      <span class="header__burger" aria-hidden="true"><span></span><span></span></span>
    </button>
  </div>
</header>

<div class="menu" id="menu-movil" data-menu inert>
  <nav class="menu__nav wrap" aria-label="Menú móvil">
    <ul role="list">
      {
        nav.map((item, i) => (
          <li style={`--i:${i}`}>
            <a class="menu__link" href={item.href} data-menu-link>
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
    <div class="menu__foot" style={`--i:${nav.length}`}>
      <p>{fullAddress()}<br />{business.address.value.district}</p>
      <div class="menu__actions">
        <a href={maps.directions} target="_blank" rel="noopener noreferrer">
          <Icon name="directions" size={18} /> Cómo llegar
        </a>
        {
          instagram && (
            <a href={instagram.url} target="_blank" rel="noopener noreferrer">
              <Icon name="instagram" size={18} /> {instagram.handle}
            </a>
          )
        }
      </div>
    </div>
  </nav>
</div>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const menu = document.querySelector<HTMLElement>('[data-menu]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const label = document.querySelector<HTMLElement>('[data-menu-label]');

  if (header && menu && toggle && label) {
    // --- Estado de la cabecera: transparente arriba del todo, sólida y ocultable después ---
    let lastY = window.scrollY;
    let ticking = false;
    const update = () => {
      const y = window.scrollY;
      header.toggleAttribute('data-solid', y > 24);
      const goingDown = y > lastY + 4;
      const goingUp = y < lastY - 4;
      if (goingDown && y > window.innerHeight * 0.6 && !header.hasAttribute('data-open')) {
        header.setAttribute('data-hidden', '');
      } else if (goingUp || y < 80) {
        header.removeAttribute('data-hidden');
      }
      lastY = y;
      ticking = false;
    };
    window.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(update);
        }
      },
      { passive: true },
    );
    update();
    // Si se enfoca algo dentro de la cabecera con teclado, debe verse.
    header.addEventListener('focusin', () => header.removeAttribute('data-hidden'));

    // --- Menú móvil ---
    const outside = () => [document.querySelector('main'), document.querySelector('footer')];
    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      label.textContent = open ? 'Cerrar' : 'Menú';
      header.toggleAttribute('data-open', open);
      menu.toggleAttribute('data-open', open);
      menu.inert = !open;
      document.documentElement.toggleAttribute('data-scroll-lock', open);
      outside().forEach((el) => el && (el.inert = open));
      if (open) {
        menu.querySelector<HTMLAnchorElement>('[data-menu-link]')?.focus({ preventScroll: true });
      }
    };

    toggle.addEventListener('click', () => {
      const open = toggle.getAttribute('aria-expanded') !== 'true';
      setOpen(open);
      if (!open) toggle.focus();
    });

    menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        toggle.focus();
      }
    });

    // Al pasar a escritorio con el menú abierto, se cierra.
    window.matchMedia('(min-width: 56rem)').addEventListener('change', (e) => e.matches && setOpen(false));
  }
</script>

<style>
  .header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    color: var(--cal);
    transition:
      transform 300ms var(--ease-out),
      background-color var(--dur-ui) ease;
  }

  .header[data-start='light']:not([data-solid]),
  .header[data-solid] {
    background: rgb(var(--toldo-rgb) / 0.97);
  }

  @supports (backdrop-filter: blur(1px)) {
    .header[data-solid] {
      background: rgb(var(--toldo-rgb) / 0.9);
      backdrop-filter: blur(12px) saturate(1.2);
    }
  }

  .header[data-hidden] {
    transform: translateY(-100%);
  }

  .header[data-open] {
    background: transparent;
    backdrop-filter: none;
  }

  .header__bar {
    display: flex;
    align-items: center;
    gap: var(--space-6);
    height: var(--header-h);
  }

  /* En la home la cabecera entra con el hero (después del marco, antes del titular). */
  .header[data-start='dark'] .header__bar {
    animation: header-in 700ms var(--ease-out) 300ms both;
  }

  @keyframes header-in {
    from {
      opacity: 0;
      transform: translateY(-10px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .header__brand {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    text-decoration: none;
    margin-right: auto;
  }

  .header__nav {
    display: none;
  }

  .header__nav ul {
    display: flex;
    gap: var(--space-2);
  }

  .header__link {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding-inline: var(--space-3);
    text-decoration: none;
    font-weight: 500;
  }

  /* Subrayado que crece desde la izquierda */
  .header__link::after {
    content: '';
    position: absolute;
    left: var(--space-3);
    right: var(--space-3);
    bottom: 0.6rem;
    height: 1.5px;
    background: var(--ocre);
    transform: scaleX(0);
    transform-origin: right;
    transition: transform var(--dur-ui) var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .header__link:hover::after {
      transform: scaleX(1);
      transform-origin: left;
    }
  }

  .header__cta {
    display: none;
    align-items: center;
    gap: var(--space-2);
    min-height: 44px;
    padding: 0.55rem 1rem;
    border: 1.5px solid rgb(var(--ocre-rgb) / 0.6);
    border-radius: var(--radius-s);
    color: var(--ocre);
    font-weight: 600;
    text-decoration: none;
    transition:
      background-color var(--dur-ui) ease,
      color var(--dur-ui) ease,
      transform var(--dur-press) var(--ease-out);
  }

  .header__cta:active {
    transform: scale(0.97);
  }

  @media (hover: hover) and (pointer: fine) {
    .header__cta:hover {
      background: var(--ocre);
      color: var(--toldo);
    }
  }

  .header__toggle {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    min-height: 44px;
    min-width: 44px;
    padding: 0 0 0 var(--space-3);
    border: 0;
    background: none;
    color: inherit;
    font-weight: 600;
  }

  .header__burger {
    display: grid;
    gap: 6px;
    width: 26px;
  }

  .header__burger span {
    height: 2px;
    background: currentColor;
    transition: transform var(--dur-ui) var(--ease-out);
  }

  .header[data-open] .header__burger span:first-child {
    transform: translateY(4px) rotate(45deg);
  }

  .header[data-open] .header__burger span:last-child {
    transform: translateY(-4px) rotate(-45deg);
  }

  @media (min-width: 56rem) {
    .header__nav,
    .header__cta {
      display: flex;
    }

    .header__toggle {
      display: none;
    }
  }

  /* ---------- Menú móvil a pantalla completa ---------- */
  .menu {
    position: fixed;
    inset: 0;
    z-index: 40;
    display: flex;
    padding-top: calc(var(--header-h) + var(--space-6));
    padding-bottom: max(var(--space-6), env(safe-area-inset-bottom));
    background: var(--toldo);
    color: var(--cal);
    overscroll-behavior: contain;
    clip-path: inset(0 0 100% 0);
    visibility: hidden;
    /* Cierre más rápido que la apertura */
    transition:
      clip-path 340ms var(--ease-drawer),
      visibility 0s linear 340ms;
  }

  .menu[data-open] {
    clip-path: inset(0 0 0 0);
    visibility: visible;
    transition:
      clip-path 480ms var(--ease-drawer),
      visibility 0s;
  }

  .menu__nav {
    overscroll-behavior: contain;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--space-7);
    overflow-y: auto;
  }

  .menu__nav ul {
    display: grid;
    gap: var(--space-2);
  }

  .menu__link {
    display: block;
    padding-block: var(--space-1);
    font-family: var(--ff-display);
    font-size: clamp(2.75rem, 12vw, 4.5rem);
    line-height: 1.05;
    text-decoration: none;
  }

  .menu__link:active {
    color: var(--ocre);
  }

  .menu li,
  .menu__foot {
    opacity: 0;
    transform: translateY(24px);
    transition:
      opacity 200ms ease,
      transform 200ms var(--ease-out);
  }

  .menu[data-open] li,
  .menu[data-open] .menu__foot {
    opacity: 1;
    transform: none;
    transition:
      opacity 500ms var(--ease-out),
      transform 600ms var(--ease-out);
    transition-delay: calc(140ms + var(--i) * 55ms);
  }

  .menu__foot {
    display: grid;
    gap: var(--space-5);
    color: rgb(var(--cal-rgb) / 0.85);
  }

  .menu__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3) var(--space-6);
  }

  .menu__actions a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 44px;
    color: var(--ocre);
    font-weight: 600;
    text-decoration: none;
  }

  :global(html[data-scroll-lock]) {
    overflow: hidden;
  }

  @media (prefers-reduced-motion: reduce) {
    .header,
    .menu,
    .menu[data-open] {
      transition-property: opacity, visibility;
    }

    .menu {
      clip-path: none;
      opacity: 0;
    }

    .menu[data-open] {
      opacity: 1;
    }

    .menu li,
    .menu__foot {
      transform: none;
    }

    .header[data-hidden] {
      transform: none;
    }

    .header[data-start='dark'] .header__bar {
      animation-name: header-fade;
    }
  }

  @keyframes header-fade {
    from {
      opacity: 0;
    }
  }
</style>
