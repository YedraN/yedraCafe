---
/**
 * Rama de yedra en SVG: el motivo de marca. El tallo se dibuja (stroke-dashoffset) y las
 * hojas brotan siguiendo el avance del trazo.
 *
 * animate="load": coreografía de entrada con CSS (hero), sin depender de JS.
 * animate="view": se dispara al entrar en pantalla (motion.ts añade [data-visible]).
 */
import { createVine, LEAF_PATH, LEAF_VEINS, type Point, type Segment } from '../../lib/vine';

interface Props {
  viewBox: string;
  start: Point;
  segments: readonly Segment[];
  leafCount: number;
  leafSize: number;
  seed?: number;
  animate?: 'load' | 'view' | 'none';
  /** Retraso de la entrada, en ms. */
  delay?: number;
  class?: string;
  preserveAspectRatio?: string;
}

const {
  viewBox,
  start,
  segments,
  leafCount,
  leafSize,
  seed,
  animate = 'view',
  delay = 0,
  class: className,
  preserveAspectRatio = 'xMidYMid meet',
} = Astro.props;

const vine = createVine({ start, segments, leafCount, leafSize, seed });
const petioles = vine.leaves.map((l) => `M${l.sx} ${l.sy}L${l.x} ${l.y}`).join('');
// Cada rama de la página usa una semilla distinta, así el id es único.
const id = `leaf-${seed ?? 0}-${leafCount}-${leafSize}`;
---

<svg
  class:list={['vine', `vine--${animate}`, className]}
  viewBox={viewBox}
  preserveAspectRatio={preserveAspectRatio}
  aria-hidden="true"
  focusable="false"
  data-reveal-trigger={animate === 'view' ? '' : undefined}
  style={`--delay:${delay}ms`}
>
  <defs>
    <g id={id}>
      <path d={LEAF_PATH} />
      <path class="vine__veins" d={LEAF_VEINS} fill="none" />
    </g>
  </defs>
  <path class="vine__stem" d={vine.d} pathLength="1" fill="none" />
  <path class="vine__petioles" d={petioles} fill="none" />
  {
    vine.leaves.map((leaf) => (
      <g transform={`translate(${leaf.x} ${leaf.y}) rotate(${leaf.rotate})`}>
        <g class={`vine__leaf vine__leaf--${leaf.tone}`} style={`--at:${leaf.at}`}>
          <use href={`#${id}`} transform={`scale(${leaf.scale}) translate(-50 -92)`} />
        </g>
      </g>
    ))
  }
</svg>

<style>
  .vine {
    --stem: var(--vine-stem, var(--yedra-3));
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
  }

  .vine__stem,
  .vine__petioles {
    stroke: var(--stem);
    stroke-width: var(--vine-width, 3);
    stroke-linecap: round;
  }

  .vine__petioles {
    stroke-width: calc(var(--vine-width, 3) * 0.6);
  }

  .vine__leaf--0 {
    fill: var(--leaf-0, var(--yedra-3));
  }
  .vine__leaf--1 {
    fill: var(--leaf-1, var(--yedra));
  }
  .vine__leaf--2 {
    fill: var(--leaf-2, var(--yedra-2));
  }

  .vine__veins {
    stroke: var(--leaf-vein, rgb(var(--pizarra-rgb) / 0.3));
    stroke-width: 1.6;
    stroke-linecap: round;
  }

  .vine__leaf {
    transform-origin: 0 0;
  }

  /* ---- Animación: tallo dibujándose + hojas brotando a su paso ---- */
  .vine--load .vine__stem,
  :global(.js) .vine--view .vine__stem {
    stroke-dasharray: 1 1;
    stroke-dashoffset: 1;
  }

  .vine--load .vine__leaf,
  .vine--load .vine__petioles,
  :global(.js) .vine--view .vine__leaf,
  :global(.js) .vine--view .vine__petioles {
    opacity: 0;
  }

  .vine--load .vine__leaf,
  :global(.js) .vine--view .vine__leaf {
    transform: scale(0.35) rotate(-18deg);
  }

  .vine--load .vine__stem {
    animation: vine-draw var(--dur-draw) var(--ease-in-out) var(--delay) forwards;
  }

  .vine--load .vine__petioles {
    animation: vine-fade 400ms ease calc(var(--delay) + var(--dur-draw) * 0.3) forwards;
  }

  .vine--load .vine__leaf {
    animation: vine-leaf 700ms var(--ease-out) calc(var(--delay) + var(--dur-draw) * var(--at) * 0.9) forwards;
  }

  :global(.js) .vine--view[data-visible] .vine__stem {
    animation: vine-draw var(--dur-draw) var(--ease-in-out) var(--delay) forwards;
  }

  :global(.js) .vine--view[data-visible] .vine__petioles {
    animation: vine-fade 400ms ease calc(var(--delay) + var(--dur-draw) * 0.3) forwards;
  }

  :global(.js) .vine--view[data-visible] .vine__leaf {
    animation: vine-leaf 700ms var(--ease-out) calc(var(--delay) + var(--dur-draw) * var(--at) * 0.9) forwards;
  }

  @keyframes vine-draw {
    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes vine-fade {
    to {
      opacity: 1;
    }
  }

  @keyframes vine-leaf {
    to {
      opacity: 1;
      transform: none;
    }
  }

  /* Menos movimiento: la yedra aparece completa con un fundido, sin crecer. */
  @media (prefers-reduced-motion: reduce) {
    .vine--load .vine__stem,
    :global(.js) .vine--view .vine__stem {
      stroke-dasharray: none;
      stroke-dashoffset: 0;
      animation: none !important;
    }

    .vine--load .vine__leaf,
    :global(.js) .vine--view .vine__leaf {
      transform: none;
    }

    .vine--load .vine__leaf,
    .vine--load .vine__petioles,
    :global(.js) .vine--view[data-visible] .vine__leaf,
    :global(.js) .vine--view[data-visible] .vine__petioles {
      animation: vine-fade 400ms ease forwards !important;
    }
  }
</style>
