---
import { business } from '../../data/business';
import { heroFrame } from '../../data/gallery';
import IvyVine from '../art/IvyVine.astro';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
import PhotoFrame from '../ui/PhotoFrame.astro';
import SplitWords from '../ui/SplitWords.astro';

const letters = [...'Yedra'];
const a = business.address.value;
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero__inner wrap">
    <p class="hero__lede">
      <SplitWords text="Desayunos, almuerzos y comidas a un paso del tranvía de Benicalap." />
    </p>

    <div class="hero__visual">
      <PhotoFrame
        frame={heroFrame}
        ratio="4 / 5"
        shape="arch"
        sizes="(min-width: 64rem) 27rem, (min-width: 40rem) 22rem, 60vw"
        eager
        reveal={false}
        captionTone="dark"
      />
      <div class="hero__vine">
      <IvyVine
        animate="load"
        delay={650}
        viewBox="0 0 640 820"
        start={[96, 690]}
        segments={[
          [[150, 650], [58, 610], [108, 540]],
          [[160, 480], [62, 410], [118, 322]],
          [[150, 250], [205, 140], [300, 94]],
          [[402, 50], [505, 148], [508, 250]],
          [[512, 330], [610, 360], [584, 456]],
        ]}
        leafCount={24}
        leafSize={92}
        seed={11}
      />
      </div>
    </div>

    <h1 class="hero__title" id="hero-title">
      {/* Letras en spans contiguos (sin espacios) para que el texto siga siendo «Yedra». */}
      <span class="hero__word" translate="no">{
        letters.map((l, i) => (
          <span class="hero__mask"><span style={`--l:${i}`}>{l}</span></span>
        ))
      }</span>
      {' '}<span class="hero__sub">café</span><span class="visually-hidden">, cafetería en Benicalap, València</span>
    </h1>

    <div class="hero__bottom">
      <address class="hero__address">
        <Icon name="pin" size={18} />
        <span>{a.street}<br />{a.postalCode} {a.district}, {a.locality}</span>
      </address>
      <div class="hero__ctas">
        <Button href="#carta" icon="down">Ver la carta</Button>
        <Button href="#visitanos" variant="line">Dónde estamos</Button>
      </div>
      <a class="hero__scroll" href="#esencia">
        <span>Desliza<span class="visually-hidden"> hasta la siguiente sección</span></span>
        <span class="hero__scroll-line" aria-hidden="true"></span>
      </a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    background: var(--toldo);
    color: var(--cal);
    overflow: clip;
  }

  .hero__inner {
    display: grid;
    grid-template-columns: 1fr;
    grid-template-areas:
      'lede'
      'visual'
      'title'
      'bottom';
    min-height: 100svh;
    padding-top: calc(var(--header-h) + var(--space-5));
    padding-bottom: max(var(--space-6), env(safe-area-inset-bottom));
  }

  /* ---------- Entradilla ---------- */
  .hero__lede {
    grid-area: lede;
    max-width: 19ch;
    font-family: var(--ff-display);
    font-size: var(--step-3);
    line-height: 1.12;
    color: var(--cal);
  }

  /* ---------- Marco en arco + yedra ---------- */
  .hero__visual {
    grid-area: visual;
    position: relative;
    justify-self: end;
    width: min(60vw, 20rem);
    margin-top: var(--space-6);
    margin-right: clamp(0rem, 6vw, 2rem);
  }

  .hero__vine {
    position: absolute;
    left: -25%;
    top: -20%;
    width: 160%;
    height: 164%;
    z-index: 3;
    --vine-width: 3.2;
    --leaf-0: var(--yedra-3);
    --leaf-1: var(--yedra);
    --leaf-2: var(--yedra-2);
    --leaf-vein: rgb(var(--pizarra-rgb) / 0.35);
  }

  .hero__visual :global(.frame__caption) {
    display: none;
  }

  /* ---------- Titular ---------- */
  .hero__title {
    grid-area: title;
    position: relative;
    z-index: 2;
    display: flex;
    align-items: flex-end;
    gap: 0.04em;
    margin-top: -0.22em;
    font-size: clamp(6rem, 31vw, 30rem);
    line-height: 0.8;
    letter-spacing: -0.035em;
    color: var(--cal);
    pointer-events: none;
  }

  .hero__word {
    display: inline-flex;
  }

  .hero__mask {
    display: inline-block;
    overflow: clip;
    overflow-clip-margin: 0.04em;
    padding-bottom: 0.06em;
  }

  .hero__mask > span {
    display: inline-block;
  }

  /* «café» en vertical, de abajo arriba, a la izquierda de la Y: como un rótulo lateral. */
  .hero__sub {
    order: -1;
    margin-right: 0.04em;
    font-family: var(--ff-text);
    font-size: max(0.105em, 1.1rem);
    font-weight: 500;
    letter-spacing: 0;
    line-height: 1;
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    padding-bottom: 0.12em;
    color: var(--ocre);
  }

  /* ---------- Pie del hero ---------- */
  .hero__bottom {
    grid-area: bottom;
    display: grid;
    gap: var(--space-5);
    margin-top: var(--space-6);
    padding-top: var(--space-5);
    border-top: 1px solid rgb(var(--cal-rgb) / 0.22);
  }

  .hero__address {
    display: flex;
    gap: var(--space-3);
    font-style: normal;
    line-height: 1.4;
    color: rgb(var(--cal-rgb) / 0.88);
  }

  .hero__address :global(.icon) {
    margin-top: 0.15em;
    color: var(--ocre);
  }

  .hero__ctas {
    display: grid;
    gap: var(--space-3);
  }

  .hero__scroll {
    display: none;
  }

  @media (min-width: 40rem) {
    .hero__ctas {
      display: flex;
      flex-wrap: wrap;
    }

    .hero__visual {
      width: min(46vw, 22rem);
    }
  }

  /* ---------- Escritorio: composición editorial asimétrica ---------- */
  @media (min-width: 64rem) {
    .hero__inner {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      grid-template-rows: auto 1fr auto auto;
      grid-template-areas: none;
      column-gap: var(--space-5);
      padding-top: calc(var(--header-h) + var(--space-6));
    }

    .hero__lede {
      grid-column: 1 / 7;
      grid-row: 1;
      font-size: var(--step-3);
      max-width: 17ch;
      margin-top: var(--space-6);
    }

    .hero__visual {
      grid-column: 9 / 13;
      grid-row: 1 / 4;
      align-self: end;
      justify-self: end;
      width: min(100%, 27rem, calc((100svh - 19rem) * 0.8));
      margin: 0 clamp(1rem, 3vw, 3rem) 0.1em 0;
    }

    .hero__title {
      grid-column: 1 / 13;
      grid-row: 3;
      margin-top: 0;
      font-size: clamp(9rem, 20vw, 26rem);
    }

    .hero__bottom {
      grid-column: 1 / 13;
      grid-row: 4;
      grid-template-columns: 1fr auto 1fr;
      align-items: center;
      margin-top: var(--space-5);
    }

    .hero__ctas {
      justify-content: center;
    }

    .hero__scroll {
      justify-self: end;
      display: inline-flex;
      align-items: center;
      gap: var(--space-4);
      min-height: 44px;
      color: rgb(var(--cal-rgb) / 0.88);
      font-size: var(--step--1);
      font-weight: 500;
      text-decoration: none;
    }

    .hero__scroll-line {
      position: relative;
      width: 1.5px;
      height: 3rem;
      background: rgb(var(--cal-rgb) / 0.25);
      overflow: hidden;
    }

    .hero__scroll-line::after {
      content: '';
      position: absolute;
      inset: 0;
      background: var(--ocre);
      transform: translateY(-100%);
      /* Tres pasadas y se detiene: una pista, no una distracción permanente. */
      animation: scroll-cue 2.4s var(--ease-in-out) 2.6s 3;
    }
  }

  @keyframes scroll-cue {
    0% {
      transform: translateY(-100%);
    }
    55%,
    100% {
      transform: translateY(100%);
    }
  }

  /* ---------- Coreografía de entrada (CSS puro; no depende de JS) ---------- */
  .hero__visual :global(.frame__media) {
    animation: hero-mask 1200ms var(--ease-in-out) 80ms both;
  }

  .hero__visual :global(.frame__art),
  .hero__visual :global(picture) {
    animation: hero-settle 1800ms var(--ease-out) 80ms both;
  }

  .hero__mask > span {
    animation: hero-rise 1100ms var(--ease-out) calc(220ms + var(--l) * 70ms) both;
  }

  .hero__sub {
    animation: hero-fade 800ms var(--ease-out) 760ms both;
  }

  .hero__lede :global(.split-word > span) {
    animation: hero-rise 900ms var(--ease-out) calc(420ms + var(--w) * 35ms) both;
  }

  .hero__bottom {
    animation: hero-fade-up 800ms var(--ease-out) 1050ms both;
  }

  @keyframes hero-mask {
    from {
      clip-path: inset(100% 0 0 0);
    }
    to {
      clip-path: inset(0 0 0 0);
    }
  }

  @keyframes hero-settle {
    from {
      transform: scale(1.14);
    }
    to {
      transform: none;
    }
  }

  @keyframes hero-rise {
    from {
      transform: translateY(108%);
    }
    to {
      transform: none;
    }
  }

  @keyframes hero-fade {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @keyframes hero-fade-up {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__visual :global(.frame__media),
    .hero__visual :global(.frame__art),
    .hero__visual :global(picture),
    .hero__mask > span,
    .hero__lede :global(.split-word > span),
    .hero__bottom {
      animation: hero-fade 500ms ease both;
    }

    .hero__scroll-line::after {
      animation: none;
      transform: none;
    }
  }
</style>
