---
import { experienceFrames } from '../../data/gallery';
import PhotoFrame from '../ui/PhotoFrame.astro';
import Pending from '../ui/Pending.astro';
import SplitWords from '../ui/SplitWords.astro';

// Composición: cada marco tiene proporción, posición y profundidad (velocidad de parallax) propias.
const missingPhotos = experienceFrames.some((f) => !f.photo);

const layout = [
  { ratio: '4 / 5', depth: -0.6, sizes: '(min-width: 48rem) 38vw, 80vw' },
  { ratio: '3 / 4', depth: 0.9, sizes: '(min-width: 48rem) 22vw, 48vw' },
  { ratio: '1 / 1', depth: -0.2, sizes: '(min-width: 48rem) 30vw, 48vw' },
  { ratio: '4 / 5', depth: 0.5, sizes: '(min-width: 48rem) 30vw, 80vw' },
  { ratio: '3 / 4', depth: -0.8, sizes: '(min-width: 48rem) 22vw, 64vw' },
] as const;
---

<section class="exp section" id="experiencia" aria-labelledby="exp-title">
  <div class="wrap">
    <div class="exp__intro">
      <h2 class="exp__title" id="exp-title" data-reveal="words">
        <SplitWords text="Una experiencia para disfrutar" />
      </h2>
      <p class="lede" data-reveal="fade">
        Un local de barrio para sentarse sin prisa o para llevarse el café puesto. Lo bueno de un sitio así se nota
        en lo pequeño.
      </p>
      {
        missingPhotos && (
          <p class="exp__note">
            <Pending label="Fotos del local pendientes" />
            <span>Mientras llegan las fotos reales, cada hueco muestra una ilustración de la marca.</span>
          </p>
        )
      }
    </div>

    <div class="exp__collage">
      {
        experienceFrames.map((frame, i) => (
          <div class={`exp__item exp__item--${i + 1}`} style={`--depth:${layout[i].depth}`}>
            <PhotoFrame
              frame={frame}
              ratio={layout[i].ratio}
              sizes={layout[i].sizes}
              seed={i + 5}
              pendingNote={false}
            />
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .exp {
    background: var(--cal);
    overflow: clip;
  }

  .exp__intro {
    display: grid;
    gap: var(--space-5);
    margin-bottom: var(--space-8);
  }

  .exp__title {
    font-size: var(--step-5);
    line-height: 1.02;
    max-width: 12ch;
  }

  .exp__intro .lede {
    color: var(--pizarra-2);
  }

  .exp__note {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-3);
    font-size: var(--step--1);
    color: var(--pizarra-2);
  }

  /* Móvil: rejilla de 6 columnas con piezas de tamaños distintos */
  .exp__collage {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: var(--space-6) var(--space-4);
    align-items: start;
  }

  .exp__item--1 {
    grid-column: 1 / 6;
  }
  .exp__item--2 {
    grid-column: 1 / 4;
    margin-top: var(--space-6);
  }
  .exp__item--3 {
    grid-column: 4 / 7;
  }
  .exp__item--4 {
    grid-column: 2 / 7;
  }
  .exp__item--5 {
    grid-column: 1 / 5;
  }

  @media (min-width: 48rem) {
    .exp__intro {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--space-5);
      align-items: end;
    }

    .exp__title {
      grid-column: 1 / 8;
    }

    .exp__intro .lede {
      grid-column: 8 / 13;
    }

    .exp__note {
      grid-column: 1 / 13;
    }

    .exp__collage {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--space-5);
      row-gap: var(--space-5);
    }

    .exp__item--1 {
      grid-column: 1 / 6;
      grid-row: 1 / 3;
    }
    .exp__item--2 {
      grid-column: 6 / 9;
      grid-row: 1;
      margin-top: var(--space-10);
    }
    .exp__item--3 {
      grid-column: 9 / 13;
      grid-row: 1;
    }
    .exp__item--4 {
      grid-column: 7 / 11;
      grid-row: 2 / 4;
      margin-top: var(--space-6);
    }
    .exp__item--5 {
      grid-column: 2 / 5;
      grid-row: 3;
      margin-top: var(--space-6);
    }
  }

  /* Parallax suave con animaciones ligadas al scroll (sin JS). Solo transform. */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .exp__item {
        animation: exp-depth linear both;
        animation-timeline: view();
        animation-range: cover;
      }
    }
  }

  /* En móvil los huecos son más estrechos: menos recorrido para que nada se solape. */
  .exp__item {
    --travel: 28px;
  }

  @media (min-width: 48rem) {
    .exp__item {
      --travel: 70px;
    }
  }

  @keyframes exp-depth {
    from {
      transform: translateY(calc(var(--depth) * var(--travel)));
    }
    to {
      transform: translateY(calc(var(--depth) * var(--travel) * -1));
    }
  }
</style>
